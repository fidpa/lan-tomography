[Unit]
Description=lan-tomography: live event watcher
Documentation=file://__INSTALL_DIR__/docs/explanation/pitfalls.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
EnvironmentFile=-__CONFIG_DIR__/lan-tomography.conf
ExecStart=__INSTALL_DIR__/src/events/event-watch.sh
Restart=always
RestartSec=10
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__BASE_DIR__
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

Nice=10
MemoryMax=128M

[Install]
WantedBy=multi-user.target
